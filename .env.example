# Setup (Windows / macOS / Linux): pnpm setup

# API (NestJS) — apps/api/src/main.ts
PORT=3000

# Web (Angular) — apps/web/package.json (skrypty dev/start)
WEB_PORT=4200

# URL backendu (do HttpClient w Angularze)
API_URL=http://localhost:3000
# Dla oddzielnie hostowanego frontendu ustaw jego origin (bez ścieżki)
WEB_ORIGIN=http://localhost:4200
# Opcjonalny publiczny URL API z prefiksem, np. https://api.example.org/api
# WEB_API_URL=/api

# Matchmaking — tylko backend, nie umieszczaj klucza w konfiguracji frontendu
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b

# PostgreSQL (docker compose) — najpierw: pnpm docker:up
POSTGRES_HOST=localhost
POSTGRES_USER=hackyeah
POSTGRES_PASSWORD=hackyeah
POSTGRES_DB=hackyeah
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hackyeah:hackyeah@localhost:5432/hackyeah
