# Setup (Windows / macOS / Linux): pnpm setup

# API (NestJS) — apps/api/src/main.ts
PORT=3000

# Web (Angular) — apps/web/package.json (skrypty dev/start)
WEB_PORT=4200

# URL backendu (do HttpClient w Angularze)
API_URL=http://localhost:3000
# Dla oddzielnie hostowanego frontendu ustaw jego origin (bez ścieżki)
WEB_ORIGIN=http://localhost:4200
# Opcjonalny publiczny URL API z prefiksem, np. https://api.example.org/api
# WEB_API_URL=/api

# Matchmaking, Tester innowacji i Kreator pomysłów — klucz dostępny tylko na backendzie
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b
# Model obrazkowy dla wizualizacji pomysłu (asystent kreatora innowacji)
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview

# Panel Zasobnika: node scripts/knowledge-admin.mjs ustawia hash hasła w .env
KNOWLEDGE_ADMIN_PASSWORD_HASH=

# Produkcja (Docker): skopiuj .env.production.example → .env i zobacz docs/DEPLOY.md

# Tryb demo (docs/DEMO.md) jest domyślnie włączony: API tworzy konta
# demo i publicznie podaje ich hasło oraz hasło administratora w formularzach
# logowania. Poza prezentacją ustaw DEMO_MODE=false.
DEMO_MODE=true
# Jawne hasło administratora — musi odpowiadać KNOWLEDGE_ADMIN_PASSWORD_HASH;
# node scripts/knowledge-admin.mjs uzupełnia oba wpisy
DEMO_ADMIN_PASSWORD=
# Wspólne hasło kont demo-tester, demo-organizator i demo-ekspert (12–128 znaków)
DEMO_ACCOUNT_PASSWORD=demo-hackyeah-2026

# PostgreSQL (docker compose) — najpierw: pnpm docker:up
POSTGRES_HOST=localhost
POSTGRES_USER=hackyeah
POSTGRES_PASSWORD=hackyeah
POSTGRES_DB=hackyeah
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hackyeah:hackyeah@localhost:5432/hackyeah

# Powiadomienia e-mail o pomysłach (opcjonalne). Bez SMTP_URL wiadomości nie są
# wysyłane, a API zapisuje w logu tylko temat pominiętego e-maila.
# SMTP_URL=smtp://uzytkownik:haslo@smtp.example.com:587
# MAIL_FROM="Łącznik <no-reply@example.com>"
# ROPS_NOTIFY_EMAIL=biuro@example.com
