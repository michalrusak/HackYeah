# Produkcja / Docker Compose (docker-compose.prod.yml)
# Skopiuj do .env i uzupełnij przed: pnpm docker:prod:up
# Pełna instrukcja: docs/DEPLOY.md

# --- Publiczny adres frontendu (CORS + cookies + linki w mailach) ---
# Musi być dokładnym originem przeglądarki (scheme + host + port, bez ścieżki).
# Wiele domen: oddziel przecinkami, np. https://app.pl,https://www.app.pl
DOCKER_WEB_ORIGIN=http://localhost:50415
DOCKER_WEB_PORT=50415
# Przykład VPN: DOCKER_WEB_ORIGIN=http://10.8.0.5:50415

# --- Frontend → API ---
# Tryb wbudowany (nginx proxy, zalecany): ścieżka względna
WEB_API_URL=/api
# Tryb rozdzielony (frontend i API na osobnych domenach):
# WEB_API_URL=https://api.twoja-domena.pl/api

# --- Cookies sesji (wymagane true za HTTPS w produkcji) ---
COOKIE_SECURE=false

# --- Reverse proxy (nginx / Traefik przed kontenerami) ---
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# --- PostgreSQL ---
POSTGRES_USER=hackyeah
POSTGRES_PASSWORD=ZMIEŃ_NA_BEZPIECZNE_HASŁO
POSTGRES_DB=hackyeah

# --- AI (matchmaking, tester, kreator pomysłów) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview

# --- Panel Zasobnika (hash hasła admina) ---
# node scripts/knowledge-admin.mjs
KNOWLEDGE_ADMIN_PASSWORD_HASH=

# --- E-mail (opcjonalnie) ---
# SMTP_URL=smtp://uzytkownik:haslo@smtp.example.com:587
# MAIL_FROM="Łącznik <no-reply@example.com>"
# ROPS_NOTIFY_EMAIL=biuro@example.com
