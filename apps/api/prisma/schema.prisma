generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login        String    @unique @db.VarChar(40)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  ownerHash    String    @unique @map("owner_hash") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  testerProjects TesterProject[]
  testerApplications TesterProjectApplication[]
  testerFeedback TesterProjectFeedback[]

  @@map("accounts")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  accountId String   @map("account_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("sessions")
}

model TesterProfile {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerHash          String             @unique(map: "uq_tester_profiles_owner") @map("owner_hash") @db.VarChar(64)
  displayName        String             @map("display_name") @db.VarChar(80)
  city               String             @db.VarChar(100)
  bio                String
  skills             String[]           @default([])
  resources          String[]           @default([])
  accessibilityNeeds String             @default("") @map("accessibility_needs")
  interests          String[]           @default([])
  availability       String             @db.VarChar(10)
  consent            Boolean            @default(true)
  isActive           Boolean            @default(true) @map("is_active")
  isDemo             Boolean            @default(false) @map("is_demo")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments        TesterAssignment[]
  projectApplications TesterProjectApplication[]

  @@map("tester_profiles")
}

model TesterSearch {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerHash      String             @map("owner_hash") @db.VarChar(64)
  query          String
  summary        String
  matches        Json
  candidateCount Int                @map("candidate_count")
  totalProfiles  Int                @map("total_profiles")
  candidateLimit Int                @map("candidate_limit")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  assignments    TesterAssignment[]

  @@index([ownerHash, createdAt], map: "idx_tester_searches_owner_created")
  @@map("tester_searches")
}

model TesterAssignment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  searchId  String        @map("search_id") @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  search    TesterSearch  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  profile   TesterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([searchId, profileId], map: "uq_tester_assignments_search_profile")
  @@map("tester_assignments")
}

model TesterProject {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId       String @map("owner_id") @db.Uuid
  owner         Account @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizerName String @map("organizer_name") @db.VarChar(100)
  title         String @db.VarChar(160)
  description   String
  requirements  String
  location      String @default("") @db.VarChar(160)
  mode          String @db.VarChar(10)
  stage         String @db.VarChar(10)
  status        String @default("open") @db.VarChar(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  pilotListing  TesterPilotListing?
  applications  TesterProjectApplication[]
  feedback      TesterProjectFeedback[]

  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  @@map("tester_projects")
}

model TesterProjectApplication {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  message   String @default("")
  status    String @default("pending") @db.VarChar(10)
  project   TesterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile   TesterProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  feedback  TesterProjectFeedback?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([projectId, accountId])
  @@index([accountId, createdAt])
  @@map("tester_project_applications")
}

model TesterProjectFeedback {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String @map("project_id") @db.Uuid
  accountId     String @map("account_id") @db.Uuid
  applicationId String @unique @map("application_id") @db.Uuid
  authorName    String @map("author_name") @db.VarChar(80)
  rating        Int
  review        String
  improvement   String @default("")
  project       TesterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  application   TesterProjectApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([projectId, accountId])
  @@index([projectId, createdAt])
  @@map("tester_project_feedback")
}

enum IdeaStage {
  POMYSL
  PROTOTYP
  TEST_MIKROSKALA
  WDROZONE
  SKALOWANIE
}

enum IdeaKind {
  IDEA
  GOOD_PRACTICE
}

// Enum zamiast flagi logicznej: moderacja z panelu administratora dołoży tu
// kolejne wartości bez migracji danych.
enum IdeaStatus {
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  REJECTED
  PUBLISHED
}

enum IdeaMessageAuthor {
  AUTHOR
  ROPS
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantMessageKind {
  CHAT
  EXPAND
  WILDCARD
}

model Idea {
  id                   String     @id @default(cuid())
  title                String
  essence              String
  problem              String
  targetAudience       String
  description          String     @default("")
  stage                IdeaStage
  kind                 IdeaKind   @default(IDEA)
  status               IdeaStatus @default(DRAFT)
  region               String     @default("")
  contactEmail         String?
  audiences            String[]
  areas                String[]
  needs                String[]
  plainLanguageSummary String?
  editTokenHash        String
  // Moderacja: pomysł czeka na reakcję ROPS / autor ma nieprzeczytaną odpowiedź.
  awaitsRops           Boolean    @default(false)
  unreadReply          Boolean    @default(false)

  // Ścieżka JST: samorząd bierze dobrą praktykę jako punkt wyjścia zamiast
  // tylko ją oglądać.
  adoptedFromId String?
  adoptedFrom   Idea?   @relation("IdeaAdoption", fields: [adoptedFromId], references: [id], onDelete: SetNull)
  adoptions     Idea[]  @relation("IdeaAdoption")

  canvas       IdeaCanvas?
  visuals      IdeaVisual[]
  messages     AssistantMessage[]
  applications Application[]
  thread       IdeaMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([kind, status])
  @@index([stage])
}

model IdeaCanvas {
  id      String @id @default(cuid())
  ideaId  String @unique
  idea    Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  version Int    @default(1)
  answers Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdeaVisual {
  id     String @id @default(cuid())
  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  prompt String
  // Opis alternatywny generowany razem z obrazem — bez niego grafika łamie
  // WCAG 1.1.1, więc pole jest wymagane.
  altText  String
  mimeType String
  data     Bytes
  model    String

  createdAt DateTime @default(now())

  @@index([ideaId, createdAt])
}

model GrantCall {
  id          String   @id @default(cuid())
  name        String
  operator    String
  description String
  opensAt     DateTime
  closesAt    DateTime
  budget      String?
  maxGrant    String?
  // Definicja pól wniosku — każdy nabór ma własny zestaw sekcji.
  sections    Json
  isPublished Boolean  @default(true)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, opensAt])
}

model Application {
  id          String    @id @default(cuid())
  ideaId      String
  idea        Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  grantCallId String
  grantCall   GrantCall @relation(fields: [grantCallId], references: [id], onDelete: Cascade)

  answers       Json
  status        ApplicationStatus @default(DRAFT)
  editTokenHash String
  submittedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grantCallId, status])
  @@index([ideaId])
}

model IdeaMessage {
  id      String            @id @default(cuid())
  ideaId  String
  idea    Idea              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  author  IdeaMessageAuthor
  content String

  createdAt DateTime @default(now())

  @@index([ideaId, createdAt])
}

model AssistantMessage {
  id      String  @id @default(cuid())
  ideaId  String?
  idea    Idea?   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  role    AssistantMessageRole
  kind    AssistantMessageKind @default(CHAT)
  content String

  createdAt DateTime @default(now())

  @@index([ideaId, createdAt])
}

enum UserRole {
  CITIZEN
  ROPS_EMPLOYEE
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  firstName             String?        @map("first_name")
  lastName              String?        @map("last_name")
  role                  UserRole       @default(CITIZEN)
  
  conversations         Conversation[] @relation("CitizenConversations")
  assignedConversations Conversation[] @relation("EmployeeConversations")
  messages              Message[]
  
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Conversation {
  id          String    @id @default(cuid())
  subject     String
  
  citizenId   String    @map("citizen_id")
  citizen     User      @relation("CitizenConversations", fields: [citizenId], references: [id])
  
  employeeId  String?   @map("employee_id")
  employee    User?     @relation("EmployeeConversations", fields: [employeeId], references: [id])
  
  messages    Message[]
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  content        String
  
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id])
  
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("messages")
}

model TesterPilotListing {
  projectId String @id @map("project_id") @db.Uuid
  project TesterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conditions Json
  reviewedProjectUpdatedAt DateTime @map("reviewed_project_updated_at") @db.Timestamptz(3)
  approvedAt DateTime @default(now()) @map("approved_at") @db.Timestamptz(3)
  reviewer String @db.VarChar(120)

  @@map("tester_pilot_listings")
}

model KnowledgeResource {
  id              String   @id
  title           String
  summary         String
  kind            String
  scope           String
  areas           String[]
  audiences       String[]
  needs           String[]
  sourceUrl       String   @map("source_url")
  sourceLabel     String   @map("source_label")
  verifiedAt      String   @map("verified_at")
  publicationYear Int?     @map("publication_year")
  videoPageUrl    String?  @map("video_page_url")
  videoUrl        String?  @map("video_url")
  facts           Json     @default("[]")
  status          String   @default("draft")
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status, kind, verifiedAt])
  @@map("knowledge_resources")
}

model KnowledgeAdminSession {
  id                String   @id
  csrfToken         String   @map("csrf_token")
  credentialVersion String   @map("credential_version")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("knowledge_admin_sessions")
}

model NeedReceipt {
  id        String   @id
  createdAt DateTime @map("created_at") @db.Date
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("need_receipts")
}

model NeedDailyCount {
  id        String   @id @default(cuid())
  day       DateTime @unique @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("need_daily_counts")
}

model NeedAreaCount {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  area      String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([day, area])
  @@map("need_area_counts")
}

model NeedTagCount {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  need      String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([day, need])
  @@map("need_tag_counts")
}

model NeedSourceCount {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  source    String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([day, source])
  @@map("need_source_counts")
}

model SearchPhraseCount {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  phrase    String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([day, phrase])
  @@map("search_phrase_counts")
}
