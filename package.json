{
  "name": "HackYeah",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "test:db": "node scripts/knowledge-test.mjs",
    "build": "turbo run build --ui=tui",
    "predev": "node scripts/setup.mjs",
    "dev": "turbo run dev --ui=tui",
    "prestart": "node scripts/setup.mjs",
    "start": "turbo run start --ui=tui",
    "lint:fix": "turbo run lint:fix --ui=tui",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:prod:seed": "docker compose -f docker-compose.prod.yml exec api /bin/sh /app/apps/api/docker-seed-all.sh",
    "db:migrate": "node scripts/testers-db.mjs migrate",
    "db:seed": "node scripts/testers-db.mjs seed",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types --ui=tui",
    "test": "turbo run test --ui=tui",
    "test:e2e": "turbo run test:e2e --ui=tui",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate:dev": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
