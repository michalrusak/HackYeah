{
  "name": "HackYeah",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "turbo run build",
    "predev": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "prestart": "node scripts/setup.mjs",
    "start": "turbo run start",
    "lint:fix": "turbo run lint:fix",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "db:migrate": "node scripts/testers-db.mjs migrate",
    "db:seed": "node scripts/testers-db.mjs seed",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate:dev": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
