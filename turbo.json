{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["TEST_DATABASE_URL"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "OPENROUTER_API_KEY",
        "OPENROUTER_MODEL",
        "API_URL",
        "WEB_API_URL",
        "WEB_ORIGIN",
        "WEB_PORT",
        "PORT"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "passThroughEnv": [
        "OPENROUTER_API_KEY",
        "OPENROUTER_MODEL",
        "API_URL",
        "WEB_API_URL",
        "WEB_ORIGIN",
        "WEB_PORT",
        "PORT"
      ],
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
